{
  "expo": {
    "name": "Socracia",
    "slug": "socracia",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "socracia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1B1B2F",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.socracia.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.socracia.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1B1B2F"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-sqlite"]
  }
}
